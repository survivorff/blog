---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SeriesCard from "@/components/SeriesCard.astro";
import { SITE } from "@/config";
import {
  getAllSeries,
  groupSeriesByTrack,
  getUnregisteredSeriesNames,
} from "@/utils/getSeries";

const posts = await getCollection("blog");
const allSeries = getAllSeries(posts);
const grouped = groupSeriesByTrack(allSeries);

// 构建时提醒：有文章用了未注册的系列名
const unregistered = getUnregisteredSeriesNames(posts);
if (unregistered.length > 0) {
  console.warn(
    `\n⚠️  以下系列名出现在文章里但未在 src/data/series.ts 注册，将不会显示在 /series：\n` +
      unregistered.map(n => `   - ${n}`).join("\n") +
      `\n`
  );
}

const totalSeriesPosts = allSeries.reduce((n, s) => n + s.posts.length, 0);
---

<Layout title={`专题 | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="pt-8 pb-6">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">专题</h1>
      <p class="mt-3 max-w-2xl opacity-80">
        成系列的深度内容。每个专题围绕一个主题连续写下来，按顺序读收获最大。
      </p>
      <p class="mt-2 text-sm opacity-60">
        共 {allSeries.length} 个专题 · {totalSeriesPosts} 篇文章
      </p>
    </section>

    {
      grouped.map(({ track, series }) => (
        <section class="border-t border-border pt-8 pb-2">
          <div class="mb-5 flex items-center gap-3">
            <h2 class="text-xl font-semibold tracking-wide">{track}</h2>
            <span class="h-px flex-1 bg-border" aria-hidden="true" />
            <span class="text-sm opacity-60">{series.length} 个专题</span>
          </div>
          <div class="grid gap-4 lg:grid-cols-2">
            {series.map(s => (
              <SeriesCard series={s} />
            ))}
          </div>
        </section>
      ))
    }

    <section class="mt-10 border-t border-border pt-8 pb-12">
      <h2 class="text-lg font-semibold">找不到想看的？</h2>
      <p class="mt-2 text-sm opacity-75">
        除了成系列的专题，还有很多独立的单篇文章。
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="/posts/"
          class="rounded-md border border-border px-3 py-1.5 text-sm transition hover:border-accent hover:text-accent"
        >
          全部文章
        </a>
        <a
          href="/categories/"
          class="rounded-md border border-border px-3 py-1.5 text-sm transition hover:border-accent hover:text-accent"
        >
          按分类浏览
        </a>
        <a
          href="/tags/"
          class="rounded-md border border-border px-3 py-1.5 text-sm transition hover:border-accent hover:text-accent"
        >
          按标签浏览
        </a>
        <a
          href="/archives/"
          class="rounded-md border border-border px-3 py-1.5 text-sm transition hover:border-accent hover:text-accent"
        >
          按时间浏览
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
