---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS, PROJECTS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-8", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        你好 👋
      </h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="scale-125 stroke-accent stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        这里是 <strong>survivorff</strong> 的技术博客。
      </p>
      <p class="mt-2">
        交易所工程师，EVM & Solana
        双链开发者。记录链上技术、交易系统、行业观察。
      </p>
      <p class="mt-2 text-sm opacity-70">
        按
        <kbd
          class="inline-flex items-center rounded border border-border px-1.5 py-0.5 font-mono text-xs"
          >/</kbd
        >
        搜索文章 · 订阅
        <a
          href="/rss.xml"
          class="text-accent underline decoration-dashed underline-offset-4 hover:no-underline"
          >RSS</a
        >
        获取更新
      </p>
      {
        SOCIALS.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">Find me on:</div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      PROJECTS.length > 0 && (
        <section id="projects" class="border-b border-border pt-10 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">项目</h2>
          <p class="mt-2 text-sm opacity-75">公开的知识库和技术实验。</p>
          <ul class="mt-5 grid gap-4 sm:grid-cols-2">
            {PROJECTS.map(project => (
              <li class="rounded-lg border border-border p-4 transition hover:border-accent hover:bg-muted/30">
                <a
                  href={project.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group block"
                >
                  <div class="flex items-center gap-2">
                    <span class="text-base">{project.icon}</span>
                    <h3 class="text-lg font-semibold group-hover:text-accent">
                      {project.name}
                    </h3>
                  </div>
                  <p class="mt-2 line-clamp-3 text-sm opacity-80">
                    {project.desc}
                  </p>
                  {project.tags && project.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-2">
                      {project.tags.map(tag => (
                        <span class="rounded-md border border-border px-2 py-0.5 text-xs opacity-70">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="categories-quick" class="border-b border-border pt-10 pb-6">
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-semibold tracking-wide">分类</h2>
        <a
          href="/categories/"
          class="text-sm opacity-70 hover:text-accent hover:opacity-100"
        >
          查看全部 →
        </a>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        <a
          href="/tags/web3/"
          class="rounded-md border border-border px-3 py-1.5 text-sm transition hover:border-accent hover:text-accent"
          >🔗 Web3 实战</a
        >
        <a
          href="/tags/engineering/"
          class="rounded-md border border-border px-3 py-1.5 text-sm transition hover:border-accent hover:text-accent"
          >🛠 工程方法</a
        >
        <a
          href="/tags/ai/"
          class="rounded-md border border-border px-3 py-1.5 text-sm transition hover:border-accent hover:text-accent"
          >🤖 AI 时代</a
        >
        <a
          href="/tags/thoughts/"
          class="rounded-md border border-border px-3 py-1.5 text-sm transition hover:border-accent hover:text-accent"
          >💭 思考随笔</a
        >
        <a
          href="/tags/notes/"
          class="rounded-md border border-border px-3 py-1.5 text-sm transition hover:border-accent hover:text-accent"
          >📚 学习笔记</a
        >
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-10 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">精选文章</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">最近文章</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        所有文章
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
