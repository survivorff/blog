---
import { getPath } from "@/utils/getPath";
import type { SeriesWithPosts } from "@/utils/getSeries";

type Props = {
  series: SeriesWithPosts;
  /** 最多预览几篇，默认 3 */
  preview?: number;
};

const { series, preview = 3 } = Astro.props;
const { name, slug, icon, desc, status, planned, posts } = series;

const count = posts.length;
const isOngoing = status === "ongoing";
const total = planned && planned > count ? planned : count;
const pct = Math.round((count / total) * 100);

const previewPosts = posts.slice(0, preview);
const restCount = count - previewPosts.length;
---

<article
  class="group flex flex-col rounded-lg border border-border p-5 transition hover:border-accent hover:bg-muted/20"
>
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-start gap-2.5">
      <span class="mt-0.5 text-2xl leading-none" aria-hidden="true">{icon}</span>
      <div class="min-w-0">
        <h3 class="text-lg font-semibold break-words">
          <a
            href={`/series/${slug}/`}
            class="decoration-dashed underline-offset-4 group-hover:text-accent group-hover:underline"
          >
            {name}
          </a>
        </h3>
        <div class="mt-1 flex flex-wrap items-center gap-2 text-xs">
          <span
            class:list={[
              "rounded px-1.5 py-0.5",
              isOngoing
                ? "bg-accent/15 text-accent"
                : "border border-border opacity-70",
            ]}
          >
            {isOngoing ? "连载中" : "已完结"}
          </span>
          <span class="opacity-60">{count} 篇</span>
        </div>
      </div>
    </div>
  </div>

  <p class="mt-3 text-sm opacity-80">{desc}</p>

  {
    planned && planned > count && (
      <div class="mt-3">
        <div
          class="h-1 w-full overflow-hidden rounded-full bg-border"
          role="progressbar"
          aria-valuenow={count}
          aria-valuemin="0"
          aria-valuemax={total}
          aria-label={`${name} 进度：${count} / ${total} 篇`}
        >
          <div class="h-full rounded-full bg-accent" style={`width:${pct}%`} />
        </div>
        <p class="mt-1 text-xs opacity-60">
          已发布 {count} / 计划 {total} 篇
        </p>
      </div>
    )
  }

  <ol class="mt-4 space-y-1.5 text-sm">
    {
      previewPosts.map(post => (
        <li class="flex gap-2">
          <span class="shrink-0 opacity-50 tabular-nums">
            {post.data.series?.order}.
          </span>
          <a
            href={getPath(post.id, post.filePath)}
            class="decoration-dashed underline-offset-4 hover:text-accent hover:underline"
          >
            {post.data.title}
          </a>
        </li>
      ))
    }
  </ol>

  <div class="mt-auto pt-4">
    <a
      href={`/series/${slug}/`}
      class="text-sm text-accent decoration-dashed underline-offset-4 hover:underline"
    >
      {restCount > 0 ? `查看全部 ${count} 篇 →` : "进入专题 →"}
    </a>
  </div>
</article>
