---
// 图片 lightbox
// 为文章中的 img 元素添加点击放大功能
---

<div
  id="lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 p-4 backdrop-blur"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <button
    id="lightbox-close"
    class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-2xl text-white hover:bg-white/20"
    aria-label="关闭"
  >
    ×
  </button>
  <img
    id="lightbox-img"
    src=""
    alt=""
    class="max-h-[90vh] max-w-[90vw] rounded-lg object-contain"
  />
  <div
    id="lightbox-caption"
    class="absolute bottom-4 left-1/2 max-w-[80vw] -translate-x-1/2 rounded-md bg-black/50 px-3 py-1 text-sm text-white/90"
  >
  </div>
</div>

<script is:inline>
  (function () {
    function setup() {
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const lightboxCaption = document.getElementById("lightbox-caption");
      const closeBtn = document.getElementById("lightbox-close");
      if (!lightbox || !lightboxImg || !closeBtn) return;

      const article = document.getElementById("article");
      if (!article) return;

      const images = article.querySelectorAll("img");

      function open(img) {
        lightboxImg.src = img.currentSrc || img.src;
        lightboxImg.alt = img.alt || "";
        if (lightboxCaption) {
          lightboxCaption.textContent = img.alt || "";
          lightboxCaption.style.display = img.alt ? "" : "none";
        }
        lightbox.classList.remove("hidden");
        lightbox.classList.add("flex");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function close() {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        lightbox.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      }

      images.forEach(img => {
        img.style.cursor = "zoom-in";
        img.addEventListener("click", () => open(img));
      });

      closeBtn.addEventListener("click", close);
      lightbox.addEventListener("click", e => {
        if (e.target === lightbox) close();
      });
      document.addEventListener("keydown", e => {
        if (e.key === "Escape" && !lightbox.classList.contains("hidden")) {
          close();
        }
      });
    }

    document.addEventListener("astro:page-load", setup);
  })();
</script>
