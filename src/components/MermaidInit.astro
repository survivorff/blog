---
// 在每个文章页加载 Mermaid，将 ```mermaid 代码块渲染为图表
// Shiki 给 mermaid 代码块加的标记是 <pre data-language="mermaid">
---

<script is:inline>
  async function renderMermaid() {
    const preBlocks = document.querySelectorAll(
      'pre[data-language="mermaid"]'
    );
    if (preBlocks.length === 0) return;

    // 动态导入 mermaid，仅在需要时加载
    const mermaid = (
      await import(
        "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
      )
    ).default;

    const theme =
      document.documentElement.dataset.theme === "dark" ? "dark" : "default";

    mermaid.initialize({
      startOnLoad: false,
      theme,
      securityLevel: "loose",
      fontFamily: "inherit",
    });

    preBlocks.forEach((pre, index) => {
      // 关键：只从 <code> 内部取代码，避免把 Copy 按钮等其他注入元素也读进来
      // Shiki 的结构：<pre><code><span class="line">...</span></code></pre>
      const codeEl = pre.querySelector(":scope > code");
      const rawText = codeEl ? codeEl.textContent : pre.textContent;
      const code = (rawText || "").trim();

      if (!code) return;

      const container = document.createElement("div");
      container.className =
        "mermaid-diagram my-6 flex justify-center overflow-x-auto";
      const id = `mermaid-${Date.now()}-${index}`;

      mermaid
        .render(id, code)
        .then(({ svg }) => {
          container.innerHTML = svg;
          pre.replaceWith(container);
        })
        .catch(err => {
          // eslint-disable-next-line no-console
          console.error("Mermaid render error:", err);
          const errBox = document.createElement("pre");
          errBox.className = "text-red-500 text-sm";
          errBox.textContent = `Mermaid render failed: ${err.message || err}`;
          pre.replaceWith(errBox);
        });
    });
  }

  // 延迟一下再执行，确保 Copy 按钮等其他 inline script 都已运行
  document.addEventListener("astro:page-load", () => {
    // rAF + setTimeout 双保险，让 mermaid 跑在所有其他 DOM 操作之后
    requestAnimationFrame(() => {
      setTimeout(renderMermaid, 0);
    });
  });
</script>
