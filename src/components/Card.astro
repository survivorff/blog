---
import { type CollectionEntry, render } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";
import ReadingTime from "./ReadingTime.astro";
import SeriesBadge from "./SeriesBadge.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const post = Astro.props;
const { variant: Heading = "h2", id, data, filePath } = post;

const { title, description, series, ...props } = data;

// 从 remark 插件注入的 frontmatter 中取阅读时间
let readingMinutes = 1;
try {
  const { remarkPluginFrontmatter } = await render(post);
  const rt = remarkPluginFrontmatter?.readingTime as number | undefined;
  if (typeof rt === "number" && rt > 0) {
    readingMinutes = rt;
  }
} catch {
  readingMinutes = 1;
}
---

<li class="my-6">
  <a
    href={getPath(id, filePath)}
    class:list={[
      "inline-block text-lg font-medium text-accent",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
  </a>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <Datetime {...props} />
    <ReadingTime minutes={readingMinutes} />
  </div>
  {
    series && (
      <div class="mt-1.5">
        <SeriesBadge name={series.name} order={series.order} compact />
      </div>
    )
  }
  <p class="mt-1.5">{description}</p>
</li>
