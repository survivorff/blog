---
// 订阅引导卡片
// 目前提供 RSS + X + GitHub 三个订阅渠道
// 后续如果启用 Newsletter（比如 Buttondown），可以在这里加邮箱表单
---

<section
  class="mt-10 rounded-lg border border-border bg-muted/20 p-6"
  data-pagefind-ignore
>
  <div
    class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"
  >
    <div>
      <h3 class="text-lg font-semibold">如果觉得有用</h3>
      <p class="mt-1 text-sm opacity-75">
        订阅更新，每次发新文章第一时间收到。不发广告、不搞推销。
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-md border border-border bg-background px-3 py-1.5 text-sm font-medium transition hover:border-accent hover:text-accent"
        aria-label="订阅 RSS"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
        RSS
      </a>
      <a
        href="https://x.com/FrankFu2262"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-md border border-border bg-background px-3 py-1.5 text-sm font-medium transition hover:border-accent hover:text-accent"
        aria-label="关注 X"
      >
        𝕏 关注
      </a>
      <a
        href="https://github.com/survivorff"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-md border border-border bg-background px-3 py-1.5 text-sm font-medium transition hover:border-accent hover:text-accent"
        aria-label="关注 GitHub"
      >
        GitHub Follow
      </a>
    </div>
  </div>
</section>
